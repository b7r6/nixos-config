cabal-version:      3.0
name:               gen-supabase-secrets
version:            0.1.0
synopsis:           Generate the Supabase secret bundle and encrypt it with agenix.
description:
  Replaces the bash gen-supabase-secrets.sh that proved fragile twice in one
  session (empty-pipe bug + unauditable openssl|tr JWT minting). JWT signing is
  now the `jose` library (correct by construction), random generation is
  `entropy` + `crypton`, and agenix invocation is Shelly with explicit stdin —
  no subshell-under-pipefail failure mode.

license:            BSD-3-Clause
author:             b7r6
build-type:         Simple

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Werror

executable gen-supabase-secrets
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  build-depends:
    , base                  >=4.19 && <5
    , base64-bytestring
    , bytestring
    , crypton
    , directory
    , entropy
    , memory
    , shelly
    , text
    , time
