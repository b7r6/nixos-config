{
	"stores": [
		{
			"name": "CAS_LOCAL",
			"fast_slow": {
				"fast": {
					"filesystem": {
						"content_path": "/var/lib/nativelink/content",
						"temp_path": "/var/lib/nativelink/tmp",
						"eviction_policy": {
							"max_bytes": 68719476736
						}
					}
				},
				"fast_direction": "get",
				"slow": {
					"experimental_cloud_object_store": {
						"provider": "r2",
						"account_id": "6063b6652178f5cf1cfb87e7e41acf1e",
						"bucket": "straylight-nativelink-cas",
						"access_key_id": "${R2_ACCESS_KEY_ID}",
						"secret_access_key": "${R2_SECRET_ACCESS_KEY}",
						"key_prefix": "cas/",
						"retry": {
							"max_retries": 6,
							"delay": 0.3,
							"jitter": 0.5
						}
					}
				}
			}
		},
		{
			"name": "AC_LOCAL",
			"fast_slow": {
				"fast": {
					"memory": {
						"eviction_policy": {
							"max_bytes": 67108864
						}
					}
				},
				"fast_direction": "get",
				"slow": {
					"experimental_cloud_object_store": {
						"provider": "r2",
						"account_id": "6063b6652178f5cf1cfb87e7e41acf1e",
						"bucket": "straylight-nativelink-cas",
						"access_key_id": "${R2_ACCESS_KEY_ID}",
						"secret_access_key": "${R2_SECRET_ACCESS_KEY}",
						"key_prefix": "ac/",
						"retry": {
							"max_retries": 6,
							"delay": 0.3,
							"jitter": 0.5
						}
					}
				}
			}
		},
		{
			"name": "REMOTE_CAS",
			"grpc": {
				"instance_name": "main",
				"store_type": "cas",
				"endpoints": [
					{
						"address": "grpc://guccimane.sju1.s4.gl:50052"
					}
				]
			}
		},
		{
			"name": "REMOTE_AC",
			"grpc": {
				"instance_name": "main",
				"store_type": "ac",
				"endpoints": [
					{
						"address": "grpc://guccimane.sju1.s4.gl:50052"
					}
				]
			}
		},
		{
			"name": "WORKER_FAST_SLOW_STORE",
			"fast_slow": {
				"fast": {
					"filesystem": {
						"content_path": "/var/lib/nativelink/worker-content",
						"temp_path": "/var/lib/nativelink/worker-tmp",
						"eviction_policy": {
							"max_bytes": 68719476736
						}
					}
				},
				"fast_direction": "get",
				"slow": {
					"ref_store": {
						"name": "REMOTE_CAS"
					}
				}
			}
		}
	],
	"global": {
		"max_open_files": 24576
	},
	"servers": [
		{
			"name": "cas",
			"listener": {
				"http": {
					"socket_address": "0.0.0.0:50052"
				}
			},
			"services": {
				"cas": [
					{
						"instance_name": "main",
						"cas_store": "CAS_LOCAL"
					}
				],
				"ac": [
					{
						"instance_name": "main",
						"ac_store": "AC_LOCAL"
					}
				],
				"bytestream": [
					{
						"instance_name": "main",
						"cas_store": "CAS_LOCAL"
					}
				],
				"health": {}
			}
		}
	],
	"workers": [
		{
			"local": {
				"worker_api_endpoint": {
					"uri": "grpc://watchtower.sju1.s4.gl:50061"
				},
				"cas_fast_slow_store": "WORKER_FAST_SLOW_STORE",
				"upload_action_result": {
					"ac_store": "REMOTE_AC"
				},
				"work_directory": "/var/lib/nativelink/work",
				"platform_properties": {
					"cpu_arch": {
						"values": ["x86_64"]
					},
					"OSFamily": {
						"values": ["linux"]
					},
					"container-image": {
						"values": [""]
					},
					"lre-rs": {
						"values": [""]
					},
					"ISA": {
						"values": ["x86-64"]
					}
				}
			}
		}
	]
}
