manifest.json
enriched_manifest.json
*_manifest.json
staging_*.json
*_cache.json
enrich_cache.json
walk_state.json
profiles.json
candidates.json
round_candidates.json
next_frontier.json

# url/archive lists
download-archive.txt
redownload.txt
batch_urls.txt

# materialized media trees
organized/
staging/
staging_organized/
